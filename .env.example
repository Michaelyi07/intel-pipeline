# Copy to .env and fill values. Secrets are read exclusively from environment variables.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/intel_pipeline_test
REDIS_URL=redis://127.0.0.1:6379/0
INTEL_WORKER_CONCURRENCY=2
MODEL_GATEWAY_URL=http://127.0.0.1:9000
MODEL_GATEWAY_TIMEOUT_SECONDS=10
MODEL_RETRY_MAX_ATTEMPTS=3
INTEL_LINK_CHECK_MIN_SCORE=60
